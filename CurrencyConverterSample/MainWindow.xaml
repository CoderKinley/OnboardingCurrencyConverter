<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CurrencyConverterSample"
        xmlns:cc="clr-namespace:CurrencyConverter;assembly=CurrencyConverter"
        xmlns:c1="http://schemas.componentone.com/winfx/2006/xaml"
        xmlns:View="clr-namespace:CurrencyConverterSample.View"
        x:Class="CurrencyConverterSample.MainWindow"
        Title="MainWindow"
        Height="450"
        Width="800">
    <Window.Resources>
        <!-- Custom style for the main container border -->
        <Style x:Key="CustomMainBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="BorderBrush" Value="#FDFAFD" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.15" Color="#6366F1" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom style for the source amount input -->
        <Style x:Key="CustomSourceAmountStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CaretBrush" Value="DarkBlue" />
        </Style>

        <!-- Custom style for the target amount display -->
        <Style x:Key="CustomTargetAmountStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#059669" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <!-- Custom style for the inner input borders -->
        <Style x:Key="CustomInputBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <cc:CurrencyConverter Grid.Row="0"
                              Margin="20"
                              ConversionProvider="{Binding CurrencyProvider}"
                              TargetCurrency="{Binding TargetCurrency, Mode=TwoWay}"
                              MainBorderStyle="{StaticResource CustomMainBorderStyle}"
                              SourceAmountStyle="{StaticResource CustomSourceAmountStyle}"
                              TargetAmountStyle="{StaticResource CustomTargetAmountStyle}"
                              SourceAmountBorderStyle="{StaticResource CustomInputBorderStyle}"
                              TargetAmountBorderStyle="{StaticResource CustomInputBorderStyle}"
                              SourceCurrencyBorderStyle="{StaticResource CustomInputBorderStyle}"
                              TargetCurrencyBorderStyle="{StaticResource CustomInputBorderStyle}" />

        <View:ProductCatalogue Grid.Row="1"
                               Padding="20"
                               DataContext="{Binding ProductViewModel}"
                               ProductNameText="{Binding ProductNameHeader}"
                               OriginalPriceText="{Binding OriginalPriceHeader}"
                               ConvertedPriceText="{Binding ConvertedPriceHeader}"
                               VerticalAlignment="Top" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="{Binding WelcomeMessage}"
                       Grid.Column="0"
                       FontSize="20"
                       Background="LightGray"
                       Margin="10" />

            <Button Content="Change Welcome Message"
                    Command="{Binding ChangeWelcomeCommand}"
                    Grid.Column="1"
                    BorderBrush="Transparent"
                    Margin="10" />
        </Grid>
    </Grid>

</Window>
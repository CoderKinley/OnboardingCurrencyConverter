<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CurrencyConverter"
                    xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
                    xmlns:models="clr-namespace:CurrencyConverter.Models">

    <local:DecimalToTwoPlacesConverter x:Key="decimalToTwoPlacesConverter" />

    <!-- Item Template -->
    <DataTemplate x:Key="CurrencyItemTemplate"
                  DataType="{x:Type models:CurrencyInfo}">
        <Grid Margin="6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <svgc:SvgViewbox x:Name="FlagIcon"
                             Source="{Binding FlagSource}"
                             Width="28"
                             Height="20"
                             Margin="0,0,12,0"
                             Stretch="Uniform" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <TextBlock Text="{Binding CurrencyCode}"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="#1A1A2E"
                           Width="40" />
                <TextBlock Text="{Binding CurrencyName}"
                           x:Name="FullCurrencyName"
                           FontSize="12"
                           Foreground="#6B7280"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ComboBoxItem}}}"
                         Value="{x:Null}">
                <Setter TargetName="FlagIcon"
                        Property="Visibility"
                        Value="Collapsed" />
                <Setter TargetName="FullCurrencyName"
                        Property="Visibility"
                        Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <ControlTemplate x:Key="ComboBoxToggleButtonTemplate"
                     TargetType="ToggleButton">
        <Grid>
            <Border x:Name="Border"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="12" />
            <Path x:Name="Arrow"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Margin="0,0,12,0"
                  Data="M 0 0 L 4 4 L 8 0 Z"
                  Fill="#6B7280"
                  Stretch="None" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="ModernComboBoxStyle"
           TargetType="ComboBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.Column="2"
                                          ClickMode="Press"
                                          Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}" />
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,0,24,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#FFFFFF"
                                        CornerRadius="12"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        MaxHeight="300"
                                        Width="250">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16"
                                                          ShadowDepth="4"
                                                          Opacity="0.1"
                                                          Color="#000000" />
                                    </Border.Effect>
                                    <ScrollViewer Margin="4"
                                                  SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default Styles -->
    <Style x:Key="DefaultMainBorderStyle"
           TargetType="Border">
        <Setter Property="Background"
                Value="#FFFFFF" />
        <Setter Property="CornerRadius"
                Value="16" />
        <Setter Property="BorderBrush"
                Value="#E5E7EB" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Padding"
                Value="4" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24"
                                  ShadowDepth="4"
                                  Opacity="0.08"
                                  Color="#000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultInputBorderStyle"
           TargetType="Border">
        <Setter Property="Background"
                Value="#F3F4F6" />
        <Setter Property="CornerRadius"
                Value="12" />
        <Setter Property="Margin"
                Value="6" />
    </Style>

    <Style x:Key="DefaultSourceAmountStyle"
           TargetType="TextBox">
        <Setter Property="FontSize"
                Value="20" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Padding"
                Value="16,0" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Foreground"
                Value="#111827" />
        <Setter Property="CaretBrush"
                Value="#6366F1" />
        <Setter Property="Resources">
            <Setter.Value>
                <ResourceDictionary>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius"
                                Value="12" />
                    </Style>
                </ResourceDictionary>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultTargetAmountStyle"
           TargetType="TextBox">
        <Setter Property="FontSize"
                Value="20" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="IsReadOnly"
                Value="True" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Padding"
                Value="16,0" />
        <Setter Property="Foreground"
                Value="#10B981" />
    </Style>

    <Style TargetType="{x:Type local:CurrencyConverter}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Height"
                Value="72" />
        <Setter Property="MainBorderStyle"
                Value="{StaticResource DefaultMainBorderStyle}" />
        <Setter Property="SourceAmountBorderStyle"
                Value="{StaticResource DefaultInputBorderStyle}" />
        <Setter Property="TargetAmountBorderStyle"
                Value="{StaticResource DefaultInputBorderStyle}" />
        <Setter Property="SourceCurrencyBorderStyle"
                Value="{StaticResource DefaultInputBorderStyle}" />
        <Setter Property="TargetCurrencyBorderStyle"
                Value="{StaticResource DefaultInputBorderStyle}" />
        <Setter Property="SourceAmountStyle"
                Value="{StaticResource DefaultSourceAmountStyle}" />
        <Setter Property="TargetAmountStyle"
                Value="{StaticResource DefaultTargetAmountStyle}" />
        <Setter Property="SourceCurrencyStyle"
                Value="{StaticResource ModernComboBoxStyle}" />
        <Setter Property="TargetCurrencyStyle"
                Value="{StaticResource ModernComboBoxStyle}" />
        <Setter Property="CurrencyItemTemplate"
                Value="{StaticResource CurrencyItemTemplate}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CurrencyConverter}">
                    <Border Style="{TemplateBinding MainBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Source Amount -->
                            <Border Grid.Column="0"
                                    Style="{TemplateBinding SourceAmountBorderStyle}">
                                <TextBox Text="{Binding SourceValue, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{TemplateBinding SourceAmountStyle}" />
                            </Border>

                            <!-- Source Currency -->
                            <Border Grid.Column="1"
                                    Style="{TemplateBinding SourceCurrencyBorderStyle}"
                                    Width="140">
                                <ComboBox Style="{TemplateBinding SourceCurrencyStyle}"
                                          ItemsSource="{TemplateBinding SupportedCurrencies}"
                                          SelectedValue="{Binding SourceCurrency, RelativeSource={RelativeSource TemplatedParent}}"
                                          ItemTemplate="{TemplateBinding CurrencyItemTemplate}"
                                          SelectedValuePath="CurrencyCode"
                                          VerticalContentAlignment="Center"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="8,0" />
                            </Border>

                            <!-- Target Amount -->
                            <Border Grid.Column="2"
                                    Style="{TemplateBinding TargetAmountBorderStyle}">
                                <TextBox Text="{Binding TargetValue, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Converter={StaticResource decimalToTwoPlacesConverter}}"
                                         Style="{TemplateBinding TargetAmountStyle}" />
                            </Border>

                            <!-- Target Currency -->
                            <Border Grid.Column="3"
                                    Style="{TemplateBinding TargetCurrencyBorderStyle}"
                                    Width="140">
                                <ComboBox Style="{TemplateBinding TargetCurrencyStyle}"
                                          ItemsSource="{TemplateBinding SupportedCurrencies}"
                                          ItemTemplate="{TemplateBinding CurrencyItemTemplate}"
                                          SelectedValue="{Binding TargetCurrency, RelativeSource={RelativeSource TemplatedParent}}"
                                          SelectedValuePath="CurrencyCode"
                                          VerticalContentAlignment="Center"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="8,0" />
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
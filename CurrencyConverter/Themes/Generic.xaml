<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CurrencyConverter"
                    xmlns:models="clr-namespace:CurrencyConverter.Models">

    <local:DecimalToTwoPlacesConverter x:Key="decimalToTwoPlacesConverter" />
    <!--How you want to view your data-->
    <DataTemplate x:Key="CurrencyItemTemplate"
                  DataType="{x:Type models:CurrencyInfo}">
        <Grid Margin="4,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding CurrencyCode}"
                       FontWeight="SemiBold"
                       Foreground="#2C3E50"
                       Width="35" />
        </Grid>
    </DataTemplate>

    <Style TargetType="{x:Type local:CurrencyConverter}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Height"
                Value="50" />
        <Setter Property="Template">
            <Setter.Value>
                <!--Control Template -> similar to the UI blueprint-->
                <ControlTemplate TargetType="{x:Type local:CurrencyConverter}">
                    <Border Background="White"
                            CornerRadius="8"
                            BorderBrush="#DCDDE1"
                            BorderThickness="1"
                            Padding="2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10"
                                              ShadowDepth="1"
                                              Opacity="0.1"
                                              Color="Black" />
                        </Border.Effect>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding SourceValue, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="18"
                                     FontWeight="Medium"
                                     VerticalContentAlignment="Center"
                                     Padding="10,0"
                                     Margin="5">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius"
                                                Value="5" />
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{TemplateBinding SupportedCurrencies}"
                                      ItemTemplate="{StaticResource CurrencyItemTemplate}"
                                      SelectedValue="{Binding SourceCurrency, RelativeSource={RelativeSource TemplatedParent}}"
                                      SelectedValuePath="CurrencyCode"
                                      VerticalContentAlignment="Center"
                                      Background="#F8F9F9"
                                      BorderThickness="0"
                                      Margin="5" />


                            <TextBox Grid.Column="2"
                                     Text="{Binding TargetValue, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Converter={StaticResource decimalToTwoPlacesConverter}}"
                                     FontSize="18"
                                     FontWeight="Bold"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     Padding="10,0"
                                     Margin="5" />

                            <ComboBox Grid.Column="3"
                                      ItemsSource="{TemplateBinding SupportedCurrencies}"
                                      ItemTemplate="{StaticResource CurrencyItemTemplate}"
                                      SelectedValue="{Binding TargetCurrency, RelativeSource={RelativeSource TemplatedParent}}"
                                      SelectedValuePath="CurrencyCode"
                                      VerticalContentAlignment="Center"
                                      Background="#F8F9F9"
                                      BorderThickness="0"
                                      Margin="5" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CurrencyConverter"
                    xmlns:models="clr-namespace:CurrencyConverter.Models">

    <DataTemplate x:Key="CurrencyItemTemplate"
                  DataType="{x:Type models:CurrencyInfo}">
        <StackPanel Orientation="Horizontal"
                    Margin="2">
            <TextBlock Text="{Binding CurrencyCode}"
                       FontWeight="Bold"
                       Width="40"
                       VerticalAlignment="Center" />
            <TextBlock Text=" - "
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding CurrencyName}"
                       Foreground="Gray"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="5,0,0,0" />
        </StackPanel>
    </DataTemplate>

    <Style TargetType="{x:Type local:CurrencyConverter}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CurrencyConverter}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="Chocolate"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="10">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding SourceValue, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="5"
                                     VerticalContentAlignment="Center"
                                     Height="32" />

                            <ComboBox x:Name="SourceCurrency"
                                      Grid.Column="1"
                                      ItemsSource="{TemplateBinding SupportedCurrencies}"
                                      ItemTemplate="{StaticResource CurrencyItemTemplate}"
                                      SelectedValue="{Binding SourceCurrency, RelativeSource={RelativeSource TemplatedParent}}"
                                      SelectedValuePath="CurrencyCode"
                                      Margin="5"
                                      VerticalContentAlignment="Center"
                                      Height="32" />

                            <TextBox Grid.Column="2"
                                     Text="{Binding TargetValue, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                     Margin="5"
                                     IsReadOnly="True"
                                     VerticalAlignment="Center"
                                     IsEnabled="False"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     FontWeight="Bold" />

                            <ComboBox x:Name="TargetCurrency"
                                      Grid.Column="3"
                                      SelectedValue="{Binding TargetCurrency,  RelativeSource={RelativeSource TemplatedParent}}"
                                      ItemsSource="{TemplateBinding SupportedCurrencies}"
                                      ItemTemplate="{StaticResource CurrencyItemTemplate}"
                                      SelectedValuePath="CurrencyCode"
                                      Margin="5"
                                      VerticalContentAlignment="Center"
                                      Height="32" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>